// Haack-series nose with a flat base.

void Init()
{
    string length = AddParm(PARM_DOUBLE_TYPE, "Length", "Design");
    SetParmValLimits(length, 4, 0.001, 1.0e12);
    SetParmDescript(length, "Axial length in model units.");

    string diameter = AddParm(PARM_DOUBLE_TYPE, "Diam.", "Design");
    SetParmValLimits(diameter, 1, 0.001, 1.0e12);
    SetParmDescript(diameter, "Diameter at the base in model units.");

    string haackCoefficient = AddParm(PARM_DOUBLE_TYPE, "C", "Design");
    SetParmValLimits(haackCoefficient, 0, 0, 1);
    SetParmDescript(haackCoefficient,
                    "Zero gives LD-Haack (von Karman). One third gives LV-Haack. Above two "
                    "thirds the profile bulges.");

    string sectionCount = AddParm(PARM_INT_TYPE, "N_XSEC", "Design");
    SetParmValLimits(sectionCount, 35, 3, 1000);
    SetParmDescript(sectionCount, "Total sections including the tip and end closure.");

    AddXSecSurf();
    string geom = GetCurrCustomGeom();
    SetParmVal(geom, "Tess_U", "Shape", 101);
    SetParmVal(geom, "Tess_W", "Shape", 49);
}

void InitGui()
{
    AddGui(GDEV_TAB, "Design");
    AddGui(GDEV_SLIDER_ADJ_RANGE_INPUT, "Length", "Length", "Design");
    AddGui(GDEV_SLIDER_ADJ_RANGE_INPUT, "Base diameter", "Diam.", "Design");
    AddGui(GDEV_SLIDER_ADJ_RANGE_INPUT, "Haack coefficient", "C", "Design");
    AddGui(GDEV_COUNTER, "Cross sections", "N_XSEC", "Design");
}

void UpdateGui() {}

void Scale(double factor)
{
    string geom = GetCurrCustomGeom();
    SetParmVal(geom, "Length", "Design", factor * GetParmVal(geom, "Length", "Design"));
    SetParmVal(geom, "Diam.", "Design", factor * GetParmVal(geom, "Diam.", "Design"));
}

const double PI = 3.14159265358979323846;

vec3d Profile(double t, double length, double radius, double k)
{
    if (t <= 0)
        return vec3d(0, 0, 0);
    if (t >= 1)
        return vec3d(length, radius, 0);
    double a = PI * t;
    double s = sin(a);
    double q = sin(0.5 * a);
    // Series avoids cancellation in a - sin(a)cos(a) at the tip.
    double area = a < 0.01 ? a * a * a * (2.0 / 3 - 2 * a * a / 15) : a - s * cos(a);
    return vec3d(length * q * q, radius * sqrt((area + k * s * s * s) / PI), 0);
}

vec3d ProfileDerivative(double t, double length, double radius, double k)
{
    if (t <= 0 || t >= 1)
        return vec3d(0, 0, 0);
    double a = PI * t, s = sin(a);
    double normalizedRadius = Profile(t, length, radius, k).y() / radius;
    return vec3d(0.5 * length * PI * s,
                 0.5 * radius * s * s * (2 + 3 * k * cos(a)) / normalizedRadius, 0);
}

void SetTangent(string section, int side, vec3d derivative)
{
    SetXSecTanAngles(section, side, Rad2Deg(atan2(derivative.y(), derivative.x())));
    SetXSecTanStrengths(section, side, derivative.mag());
}

void UpdateSurf()
{
    string geom = GetCurrCustomGeom();
    double radius = 0.5 * GetParmVal(geom, "Diam.", "Design");
    double length = GetParmVal(geom, "Length", "Design");
    double k = GetParmVal(geom, "C", "Design");
    int count = GetIntParmVal(GetParm(geom, "N_XSEC", "Design"));

    string surf = GetXSecSurf(geom, 0);
    if (GetNumXSec(surf) != count)
    {
        ClearXSecSurfs();
        surf = AddXSecSurf();
        for (int i = 0; i < count; ++i)
        {
            AppendCustomXSec(surf, (i == 0 || i == count - 1) ? XS_POINT : XS_CIRCLE);
        }
    }

    int intervals = count - 2;
    for (int i = 0; i <= intervals; ++i)
    {
        string section = GetXSec(surf, i);
        double t = double(i) / intervals;
        vec3d point = Profile(t, length, radius, k);
        SetCustomXSecLoc(section, vec3d(point.x(), 0, 0));
        if (i > 0)
            SetXSecWidthHeight(section, 2 * point.y(), 2 * point.y());

        // One unit of OpenVSP loft parameter spans one pair of adjacent ribs.
        vec3d tangent = ProfileDerivative(t, length, radius, k) / intervals;
        if (i == 0)
        {
            // r grows as t^(3/2) near the point. Fit the first cubic's radial
            // derivative at its midpoint while keeping the physical tip tangent vertical.
            double h = 1.0 / intervals;
            double r1 = Profile(h, length, radius, k).y();
            double rHalf = Profile(0.5 * h, length, radius, k).y();
            double strength =
                8 * (rHalf - 0.5 * r1) + h * ProfileDerivative(h, length, radius, k).y();
            tangent = vec3d(0, strength, 0);
        }
        SetTangent(section, XSEC_BOTH_SIDES, tangent);
    }

    // The rear face has a separate radial tangent, keeping its plane and rim sharp.
    string end = GetXSec(surf, count - 1);
    SetCustomXSecLoc(end, vec3d(length, 0, 0));
    SetTangent(GetXSec(surf, count - 2), XSEC_RIGHT_SIDE, vec3d(0, -radius, 0));
    SetTangent(end, XSEC_BOTH_SIDES, vec3d(0, -radius, 0));
    SkinXSecSurf();
}
