// Example of a custom component with an optional second surface.
// Adapted from the OpenVSP bundled custom component.

void Init()
{
    string length = AddParm(PARM_DOUBLE_TYPE, "Length", "Design");
    SetParmValLimits(length, 3, 0.001, 1e12);
    string onoff_flag = AddParm(PARM_BOOL_TYPE, "OnOffFlag", "Design");
    SetParmVal(onoff_flag, 0.0);

    string geom_id = GetCurrCustomGeom();
    SetParmVal(GetParm(geom_id, "Tess_U", "Shape"), 13);
    SetParmVal(GetParm(geom_id, "Tess_W", "Shape"), 13);
}

void InitGui()
{
    AddGui(GDEV_TAB, "Design");
    AddGui(GDEV_YGAP);
    AddGui(GDEV_DIVIDER_BOX, "Test On/Off");
    AddGui(GDEV_SLIDER_ADJ_RANGE_INPUT, "Length per body", "Length", "Design");
    AddGui(GDEV_TOGGLE_BUTTON, "On", "OnOffFlag", "Design");
}

void UpdateGui() {}

void UpdateSurf()
{
    string geom_id = GetCurrCustomGeom();

    bool onoff_flag = GetBoolParmVal(GetParm(geom_id, "OnOffFlag", "Design"));

    ClearXSecSurfs();

    string xsec_surf = AddXSecSurf();
    double length = GetParmVal(geom_id, "Length", "Design");
    BuildObj(xsec_surf, length, length / 3);

    if (onoff_flag)
    {
        string second_surf = AddXSecSurf();
        BuildObj(second_surf, length, 2 * length / 3);
        Matrix4d mat;
        mat.translatef(length, 0.0, 0.0);
        SetXSecSurfGlobalXForm(second_surf, mat);
    }

    SkinXSecSurf();
}

void BuildObj(string surf_id, double length, double dia)
{
    AppendCustomXSec(surf_id, XS_POINT);
    string xsec1 = AppendCustomXSec(surf_id, XS_CIRCLE);
    string xsec2 = AppendCustomXSec(surf_id, XS_POINT);

    SetCustomXSecLoc(xsec1, vec3d(length / 2, 0, 0));
    SetParmVal(GetXSecParm(xsec1, "Circle_Diameter"), dia);

    SetCustomXSecLoc(xsec2, vec3d(length, 0, 0));
}

void Scale(double factor)
{
    string geom = GetCurrCustomGeom();
    SetParmVal(geom, "Length", "Design", factor * GetParmVal(geom, "Length", "Design"));
}
